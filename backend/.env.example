# =============================================================================
# ExamSecure Backend Environment Configuration Template (.env.example)
# Copy this file to .env and configure your values.
# =============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8080
DEBUG=false
APP_NAME="ExamSecure Examination Platform"

# Supabase Cloud PostgreSQL Database Credentials
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require
DB_HOST=db.example.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_NAME=postgres
DB_SSLMODE=require

# Initial Super Administrator Provisioning Bootstrap
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=your_secure_admin_password_here
ADMIN_BOOTSTRAP_FULLNAME=Administrator

# Application Cryptographic Secret
SECRET_KEY=your_random_secret_key_here

# Security & Rate Limiter Configuration
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15

# Session Configuration
SESSION_COOKIE_NAME=JSESSIONID
SESSION_MAX_AGE=7200

# Document Storage Path & Limits
UPLOAD_DIR=./private-storage/documents
MAX_FILE_SIZE_BYTES=26214400
