{
  "expo": {
    "name": "ExamSecure",
    "slug": "examsecure-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.kalpanaaasoftwaresolutions.examsecure",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is required for proctored exam identity verification.",
        "NSMicrophoneUsageDescription": "Microphone is required for proctored exam audio monitoring.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "in.kalpanaaasoftwaresolutions.examsecure",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-asset",
      "expo-font"
    ],
    "scheme": "examsecure",
    "extra": {
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9bcea989-afc2-40b9-9623-54f25d30036e"
      }
    },
    "owner": "kss-kalpanaaa"
  }
}
